rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Must match ALLOWED_STAFF_EMAILS in firebase-config.js (keep both in sync).
    function isStaff() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'kaleferr@gmail.com',
          'derekgf27@gmail.com'
        ];
    }

    match /reservations/{reservationId} {
      allow read: if isStaff();

      allow create: if isStaff()
                    && request.resource.data.keys().hasAll(['id', 'eventDate'])
                    && request.resource.data.id is string
                    && request.resource.data.id.size() > 0
                    && request.resource.data.eventDate is string;

      allow update: if isStaff()
                    && request.resource.data.keys().hasAll(['id', 'eventDate'])
                    && request.resource.data.id is string
                    && request.resource.data.id.size() > 0
                    && request.resource.data.eventDate is string
                    && request.resource.data.id == resource.data.id;

      // Soft-delete preferred; hard delete allowed for trash purge
      allow delete: if isStaff();
    }

    match /menuConfig/{docId} {
      allow read, write: if isStaff();
    }

    // Atomic invoice counters: counters/invoices-YYYY
    match /counters/{counterId} {
      allow read, write: if isStaff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
